{
  "name": "genion-agents",
  "version": "0.1.0",
  "description": "Minimal agent runtime: loop, tools, memory, routines (MVP scaffold)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "demo": "tsx scripts/demo.ts",
    "tools:smoke": "tsx scripts/tools-smoke.ts",
    "test": "tsx scripts/run-tests.ts",
    "routine:run": "tsx scripts/run-routines.ts",
    "routine:watch": "tsx scripts/routine-watch.ts",
    "routine:add": "tsx scripts/routine-add.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "license": "MIT"
}
